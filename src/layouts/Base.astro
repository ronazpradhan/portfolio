---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  jsonld?: object;
}
const { title, description = site.description, type = 'website', jsonld } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · web products & machine learning`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0d17" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="wrap">
        <a class="brand" href="/"><span class="mono-mark" aria-hidden="true">RP</span>Ronaz Pradhan</a>
        <nav aria-label="Primary">
          <ul>
            <li><a href="/#work">Work</a></li>
            <li><a href="/#about">About</a></li>
            <li><a href="/#notes">Notes</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <a class="to-top" href="#main" aria-label="Back to top" id="to-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></a>
    <footer class="wrap foot">
      <span>© 2026 Ronaz Pradhan · Built with Astro, no framework on the client.</span>
      <a href={`${site.github}/portfolio`}>Source on GitHub</a>
    </footer>
    <script>
      // Reveal-on-scroll: one observer for the whole page.
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('[data-reveal], .bars').forEach((el) => io.observe(el));
      const top = document.getElementById('to-top')!;
      addEventListener('scroll', () => top.classList.toggle('show', scrollY > 600), { passive: true });
      top.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0 }); });
    </script>
  </body>
</html>
