---
import { Image } from 'astro:assets';
import ludo from '../assets/ludo.png';
import jutpatti from '../assets/jutpatti.png';

const cards = [
  { rank: 'A', suit: '♠', red: false, title: 'Jutpatti', href: '/work/jutpatti', img: jutpatti, alt: 'Jutpatti table on a phone showing my seven cards and only a card count for the opponent',
    text: 'The Nepali card game, online. The server deals with crypto.randomInt and never sends anyone another player\'s hand.',
    tags: 'Node.js · server-authoritative · 51 tests' },
  { rank: 'K', suit: '♥', red: true, title: 'CIFAR-10', href: '/work/cifar-10',
    text: 'Classical ML vs a CNN on 60,000 tiny images. I built the PCA + Random Forest / KNN / Naive Bayes / Decision Tree side.',
    tags: 'Python · scikit-learn · Colab' },
  { rank: 'Q', suit: '♦', red: true, title: 'Money Tracker', href: 'https://github.com/ronazpradhan/money-tracker-web',
    text: 'Offline-first Android app for logging income and expenses. Data stays on the phone. No account needed.',
    tags: 'React Native · Expo · SQLite' },
  { rank: 'J', suit: '♣', red: false, title: 'Ludo', href: '/work/ludo', img: ludo, alt: 'Ludo board on a phone, one player against three computer players',
    text: 'Multiplayer Ludo with friends via a room code. No ads, no coin shop. Rejoin after a dropped connection, bots cover idle players.',
    tags: 'Node.js · WebSocket · vanilla JS' },
];
const bars = [43.74, 36.25, 31.22, 25.62, 85.4];
---
<div class="table" data-reveal>
  <ul class="hand">
    {cards.map((c) => (
      <li>
        <a class={`card ${c.red ? 'suit-r' : 'suit-b'}`} href={c.href}>
          <span class="corner tl" aria-hidden="true">{c.rank}<span>{c.suit}</span></span>
          <span class="corner br" aria-hidden="true">{c.rank}<span>{c.suit}</span></span>
          <div class="art">
            {c.img ? (
              <Image src={c.img} alt={c.alt} widths={[300, 600]} sizes="17.5rem" loading="lazy" />
            ) : c.title === 'CIFAR-10' ? (
              <svg viewBox="0 0 200 150" role="img" aria-label="Bar chart of CIFAR-10 accuracies">
                {bars.map((b, i) => <rect x={22 + i * 34} y={130 - b * 1.3} width="22" height={b * 1.3} rx="4" fill={i === 4 ? '#1c1b22' : '#d6293a'} opacity={i === 4 ? 0.25 : 1 - i * 0.15} />)}
                <line x1="14" y1="130.5" x2="186" y2="130.5" stroke="#1c1b22" stroke-opacity=".3" />
              </svg>
            ) : (
              <span style="font:700 4.5rem/1 var(--display);color:#1c1b22" aria-hidden="true">रू</span>
            )}
          </div>
          <div class="body">
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <span class="tags">{c.tags}</span>
            <span class="go">{c.href.startsWith('http') ? 'Public page ↗' : 'Read the case study →'}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</div>
