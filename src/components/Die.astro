---
// A Ludo die. Every face is a true fact; rolling picks one.
const facts = [
  { k: '0 ads', t: 'No ads, no coin shop and no pay-to-win in my Ludo. That was the reason to build it.', c: 'var(--red)' },
  { k: '51 / 51', t: 'Tests passing in the Ludo + Jutpatti repo, including a statistical fairness test of the shuffle.', c: 'var(--green)' },
  { k: '1 dependency', t: 'The whole multiplayer server runs on Node and the ws package. Nothing else.', c: 'var(--blue)' },
  { k: '43.74%', t: 'My best classical model on CIFAR-10 (Random Forest after PCA). Chance is 10%.', c: 'var(--yellow)' },
  { k: '2028', t: 'When I finish my BSc CSIT at Tribhuvan University. 4th semester right now.', c: 'var(--blue)' },
  { k: 'crypto.randomInt', t: 'What shuffles every Jutpatti deck. No seeds, no Math.random.', c: 'var(--green)' },
];
const pips: Record<number, number[]> = { 1: [5], 2: [3, 7], 3: [3, 5, 7], 4: [1, 3, 7, 9], 5: [1, 3, 5, 7, 9], 6: [1, 3, 4, 6, 7, 9] };
const pos = (i: number) => `grid-area:${Math.ceil(i / 3)}/${((i - 1) % 3) + 1}`;
---
<div class="dice-box" data-reveal style="--d:150ms">
  <button class="die-btn" type="button" aria-label="Roll the die for a random fact" id="roll">
    <div class="die" id="die">
      {[1, 2, 3, 4, 5, 6].map((n) => (
        <div class={`face f${n}`} data-n={n}>{pips[n].map((p) => <i style={pos(p)}></i>)}</div>
      ))}
    </div>
  </button>
  <div class="fact" id="fact" aria-live="polite" style={`--c:${facts[0].c}`}>
    <small id="fact-n">rolled 1</small>
    <div class="k" id="fact-k">{facts[0].k}</div>
    <p id="fact-t">{facts[0].t}</p>
  </div>
</div>
<script define:vars={{ facts }}>
  const face = { 1: [0, 0], 2: [0, -90], 3: [-90, 0], 4: [90, 0], 5: [0, 90], 6: [0, 180] };
  const die = document.getElementById('die');
  const box = document.getElementById('fact');
  let spins = 0, last = 1;
  const show = (n) => {
    const f = facts[n - 1];
    box.style.setProperty('--c', f.c);
    document.getElementById('fact-n').textContent = `rolled ${n}`;
    document.getElementById('fact-k').textContent = f.k;
    document.getElementById('fact-t').textContent = f.t;
  };
  document.getElementById('roll').addEventListener('click', () => {
    let n;
    do n = 1 + Math.floor(Math.random() * 6); while (n === last);
    last = n;
    spins += 2;
    const [x, y] = face[n];
    die.style.transform = `rotateX(${x - 24 + spins * 360}deg) rotateY(${y + 32 + spins * 360}deg)`;
    const slow = matchMedia('(prefers-reduced-motion: no-preference)').matches;
    setTimeout(() => show(n), slow ? 650 : 0);
  });
</script>
