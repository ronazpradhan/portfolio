---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary} type="article">
  <article>
    <header class="row doc-head">
      <p class="label"><a href="/#work">← Work</a></p>
      <div>
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
        <dl class="facts">
          <div><dt>Type</dt><dd>{d.kind}</dd></div>
          <div><dt>Status</dt><dd>{d.status}</dd></div>
          <div><dt>My role</dt><dd>{d.role}</dd></div>
          <div><dt>Stack</dt><dd>{d.stack.join(', ')}</dd></div>
          {d.repo && <div><dt>Source</dt><dd><a href={d.repo}>{d.repo.replace('https://', '')}</a></dd></div>}
        </dl>
      </div>
    </header>
    <div class="row">
      <nav aria-label="Sections">
        <ol class="toc">
          {headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>
