---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary} type="article">
  <article class="prose">
    <h1>{d.title}</h1>
    <p>{d.summary}</p>
    <p class="facts">
      <span>{d.kind}</span><span>{d.status}</span><span>{d.role}</span>
    </p>
    <p class="stack">{d.stack.join(' · ')}</p>
    {d.repo && <p class="small"><a href={d.repo}>Source on GitHub</a></p>}
    <Content />
  </article>
</Base>
